# local-code-agent configuration
# Copied to .env automatically on first run (never commit .env).
# Every script reads this file; change a value and re-run the matching script.

# --- Auto-tune -------------------------------------------------------------
# true  = on every boot (and during setup) scripts/tune.sh detects the VM's
#         RAM and picks the best model + context length automatically, so
#         resizing the droplet upgrades/downgrades the model by itself.
# false = you pin MODEL_NAME / OLLAMA_CONTEXT_LENGTH manually below.
AUTO_TUNE=true

# The Ollama model used by aider and Open WebUI. When AUTO_TUNE=true this is
# managed for you. See README for the RAM ladder (3b/7b/14b variants).
MODEL_NAME=qwen2.5-coder:7b

# Which model FAMILY auto-tune picks from. It chooses the largest size in this
# family that fits your RAM, so you can change the model everywhere by changing
# one line. Supported: qwen2.5-coder (default, best all-round coder),
# qwen3, deepseek-coder-v2, llama3.1, codellama.
# An unknown value falls back to the default rather than failing a pull.
MODEL_FAMILY=qwen2.5-coder

# --- Ollama server ---------------------------------------------------------
# Listen address for the Ollama API. Keep it on loopback: phone access goes
# through Open WebUI over Tailscale, so Ollama never needs to be exposed.
OLLAMA_HOST=127.0.0.1:11434

# Context window (tokens). Managed by auto-tune; lower it if you hit OOM.
OLLAMA_CONTEXT_LENGTH=8192

# How long a model stays loaded in RAM after the last request. Once it unloads,
# the next message pays the load again — around 20 seconds on a droplet, which
# is the whole delay before the first reply of a session.
#
# Set this to -1 to keep the model resident permanently, so the first message is
# as fast as the rest. The cost is that the model's RAM (see 'lca speed' for the
# size) is never given back. On a box that does nothing else, that is usually
# the right trade; on a shared machine it is not.
OLLAMA_KEEP_ALIVE=30m

# --- Aider (terminal coding agent) -----------------------------------------
# Pin a specific aider-chat version (e.g. 0.86.1). Empty = latest.
AIDER_VERSION=

# Python interpreter used to create the virtualenv.
PYTHON_BIN=python3

# Virtualenv directory name (created inside this repository).
VENV_NAME=.venv

# true = load config/CONVENTIONS.md read-only every aider session so the local
# model makes smaller, in-style edits. Costs a little context; set false on the
# smallest (4096-token) windows if you need every token for the task.
AIDER_CONVENTIONS=true

# Aider commits every edit it makes, which is what lets you review one change
# at a time ('git diff HEAD~1') and undo exactly one ('git revert <sha>').
# A local model sometimes edits things you did not ask about, so this net
# matters. Set true to review a dirty tree yourself instead — you keep full
# control, and you lose the one-commit-per-change trail.
AIDER_NO_AUTO_COMMIT=false

# NOTE the LCA_ prefix: .env is sourced with 'set -a', so every key here is
# EXPORTED. 'AIDER_EDIT_FORMAT' is aider's own env var, and setting it to our
# sentinel "auto" (not a valid aider format) breaks every direct 'aider' call —
# including 'aider --version'. Keep our own knobs out of the AIDER_ namespace.
# How aider asks the model to express edits. "auto" (recommended) picks per
# model: small models (<=4B) get "whole" (rewrite the file — far more reliable
# than diffs for them), bigger ones get "diff" (much cheaper on context).
# Force one with: whole | diff | udiff | diff-fenced
LCA_EDIT_FORMAT=auto

# Max tokens 'lca ask' will generate for one answer. On CPU (a few tokens per
# second) an uncapped reply can run for minutes; raise it for longer answers.
LCA_ASK_TOKENS=512

# --- Private network -------------------------------------------------------
# true = don't install Tailscale. Use this if you already have a private
# network to reach the box from your phone (WireGuard, ZeroTier, a LAN, an
# existing VPN). Tailscale is how this project offers phone access, not the
# only way to have it — but with it skipped, getting to the WebUI privately
# is yours to arrange.
SKIP_TAILSCALE=false

# --- Docker / Open WebUI (the phone chat app) ------------------------------
# true = skip Docker entirely (also disables Open WebUI).
SKIP_DOCKER=false

# false = don't install/run Open WebUI (aider still works in the terminal).
ENABLE_WEBUI=true

# Port Open WebUI listens on (reached from your phone via Tailscale).
WEBUI_PORT=3000

# Name of the Open WebUI docker container.
WEBUI_CONTAINER=open-webui

# --- The autonomous agent (OpenHands) --------------------------------------
# A second, more powerful tier than aider: it runs a real browser UI, plans
# multi-step work, and executes it inside its own Docker sandbox without
# stopping to confirm each step. Off by default — it is a large download and a
# far bigger blast radius than 'lca', so it is opt-in.
ENABLE_AGENT=false

# Port the agent's web UI listens on, reached from your phone over Tailscale.
# NOT 3000: that is WEBUI_PORT's default and the agent's own docs use 3000 too,
# so the two would fight for the same socket on a --network=host box.
AGENT_PORT=3001

# Let containers reach Ollama without moving Ollama off loopback.
#
# A container's loopback is the container, so the agent tier reaches this
# machine as the docker bridge gateway — where nothing is listening. The relay
# binds THAT ONE address (not 0.0.0.0) and forwards to 127.0.0.1, using
# systemd-socket-proxyd, which ships with systemd. Turn this on if you turn
# ENABLE_AGENT on; without it every task the agent is given fails without
# producing a token and nothing else looks wrong.
ENABLE_OLLAMA_RELAY=false
OLLAMA_RELAY_PORT=11435

# Does the agent use the model's NATIVE tool-calling channel, or parse tool
# calls out of the text it writes?
#
# false, and that default is measured rather than cautious. qwen2.5-coder never
# fills the API's tool_calls field: its own chat template tells it to wrap calls
# in <tool_call> tags, it ignores that and writes clean JSON in the message body
# instead, and Ollama — finding no tags — reports zero tool calls. OpenHands
# reads "assistant replied, no tool calls" as "the agent is finished", so a run
# ends immediately with an empty workspace and no error anywhere to find.
#
# Measured on 3b and 7b alike, on both /api/chat and /v1/chat/completions. With
# this false, OpenHands parses the JSON the model actually writes — and the 3b
# then created the file, ran it and finished the task properly.
#
# Set it true only for a model that really does use the native channel (the
# plain qwen2.5 instruct models do; the -coder ones do not).
AGENT_NATIVE_TOOL_CALLING=false

# The context window the AGENT gets, without giving it to everything else.
#
# OLLAMA_CONTEXT_LENGTH is server-wide, and the agent needs far more than the
# chat app does — its first prompt on a real run was 18,353 tokens, counted by
# the model's own tokenizer. Raising the
# server default for everyone is not free: measured, the 3b at 32768 costs
# 3.4 GB resident against 2.2 GB at 4096, and generates at 4.07 tok/s against
# 10.41. And a per-request num_ctx cannot do it — Ollama's OpenAI endpoint,
# which is the one the agent speaks, ignores it.
#
# So the agent gets its own DERIVED model: the same weights with one PARAMETER
# line, named <MODEL_NAME>-agent. 'lca tune' builds it and rebuilds it whenever
# the ladder moves; 'lca check' proves Ollama really loads it at this value.
# Never applied below the server default.
#
# Going over this does not cost you the overflow, it costs you half. Measured
# on ollama 0.32.5: a prompt longer than num_ctx is not trimmed to fit, it is
# cut to num_ctx/2 + 2 with keep=4 — the first 4 tokens and then the TAIL, so
# the role, the security policy and the filesystem rules are exactly what goes,
# while the run still looks successful. The agent's first prompt was 18,353
# against this 16384: over by 1,969, and 10,159 were thrown away.
# See docs/PROMPT-WINDOW.md.
AGENT_MODEL_CONTEXT=16384


# Name of the agent's docker container.
AGENT_CONTAINER=openhands-app

# The images. Pinned, not 'latest': an agent that can run anything on your
# machine is the last thing that should change under you without warning.
AGENT_IMAGE=docker.openhands.dev/openhands/openhands:1.8
AGENT_RUNTIME_IMAGE=ghcr.io/openhands/agent-server
AGENT_RUNTIME_TAG=1.26.0-python

# How long one unattended run may take, and how many steps it may take. Both
# are enforced by this project, not by the agent — see docs/AGENT.md.
AGENT_MAX_ITERATIONS=100
AGENT_TIMEOUT_MINUTES=180

# Stuck detector: give up on an approach after this many consecutive rounds
# that fail the same way, rather than looping on it until the timeout.
AGENT_STUCK_STRIKES=3

# Which ref of github.com/OpenHands/extensions the agent may load skills from.
#
# The default names a ref that does not exist, and that is the point. On
# startup the agent-server clones that repository and lists everything it finds
# in a <SKILLS> block in the system prompt: measured here, 57 skills and 4,232
# tokens, 23% of an 18,353-token prompt that had to fit in a 16,384 window and
# did not (docs/PROMPT-WINDOW.md). The catalogue is linear, datadog, discord,
# azure-devops, bitbucket and the like — capabilities this tier is not for, on
# a rung whose model has never successfully emitted a native tool call.
#
# OpenHands offers no setting for this: load_public_skills is already false in
# this stack's settings and its app server overrides that with a hardcoded
# load_public=True. A ref that cannot resolve makes the fetch fail, and failing
# to load public skills is defined to return an empty list.
#
# Set this to 'main' if your box does have those credentials and wants them.
AGENT_EXTENSIONS_REF=lca-public-skills-disabled

# How long the app waits for a new sandbox's agent-server to answer before it
# gives up and calls the sandbox broken.
#
# OpenHands allows 15 seconds. Measured on this box, two sandboxes six minutes
# apart: one was ready in 12.40s and worked, the other took 16.55s and did not.
# When it loses that race the app marks the sandbox ERROR, never creates the
# conversation, and leaves the container running. Against the app's own record,
# 5 of 23 submissions here ended that way -- 21.7%, on three separate dates --
# and every one was reported as a successful submit until 'lca agent task'
# learned to read the outcome. 120 seconds costs nothing when a sandbox is
# ready in twelve.
#
# Note the OH_ prefix this becomes. OpenHands documents a plain
# SANDBOX_STARTUP_GRACE_SECONDS, and on this stack that variable is never read:
# it lives in a legacy branch that only runs when no sandbox kind is
# configured, and this project configures one. Verified by setting each to 1 in
# turn -- only OH_SANDBOX_STARTUP_GRACE_SECONDS changed the behaviour.
AGENT_SANDBOX_GRACE_SECONDS=120

# How full the model's context window may get before the watcher says so.
#
# The agent's prompt starts at 13,783 tokens of a 16,384 window, so a whole
# conversation has about 2,601 to spend -- and every observation is appended and
# never removed. Measured: reading one 100-line source file costs 1,287 of them,
# and a 300-line file costs 3,652, which ends the conversation in a single turn.
#
# Going over is not a soft failure. Ollama keeps the first 4 tokens and the
# TAIL, deleting the role, the security policy, the filesystem rules and the
# definition of the tool that runs commands -- and then answers confidently
# anyway. 'lca agent watch' STOPS a run when that happens, which is not
# configurable, and warns at this percentage before it does.
AGENT_CONTEXT_WARN_PERCENT=90

# Where the step ceiling counts steps from.
#
#   auto    the agent's own event API, falling back to its container log
#   events  the event API only — if it never answers, 'lca agent watch' says
#           the ceiling is not armed instead of quietly counting the wrong thing
#   log     the container log only
#
# 'auto' is right for this build. Measured on 1.8: a 27-minute reasoning turn
# that ran to completion added ONE line to the sandbox log, and it was a cost
# warning — so a ceiling counting log lines can never fire. The event API
# carries one entry per event. The wall clock and the stuck detector work on
# either. See docs/AGENT.md.
AGENT_STEP_SOURCE=auto

# Include the agent's state directory (~/.openhands) in backups.
#
# Off by default, and that is a size decision rather than a privacy one: it is
# the only thing this stack backs up whose size nobody controls. .env, the model
# list and the chat app's volume are all bounded; this is not.
#
# CORRECTED, 2026-08-22. This said the directory "holds whole checked-out
# projects". It does not and never did -- the agent's files live inside its
# sandbox container, which has no mounts at all. Measured on this box, the 9.5 MB
# here is 9.3 MB of conversation event logs (v1_conversations, ~400 KB of state
# per conversation) and a 212 KB sqlite database. The growth is real; the reason
# given for it was wrong.
#
# It now also holds ~/.openhands/workspaces -- the agent's actual output, copied
# out of each sandbox before that container is destroyed. That is what makes
# backing this directory up worth doing at all: before that existed, "include
# the agent's workspace" archived everything EXCEPT the agent's work.
BACKUP_AGENT_WORKSPACE=false

# ...and the ceiling that keeps it honest when it IS on. A workspace larger
# than this is SKIPPED with a warning naming its real size, rather than
# silently turning a 4 KB backup into a 40 GB one on a VPS with a fixed disk.
# 0 means no ceiling, on purpose, like the other 0s here.
BACKUP_AGENT_MAX_MB=2048

# Title shown in the chat app on your phone (branding only).
WEBUI_NAME=local-code-agent

# true only until you created YOUR account (the first account is the admin).
# Then set false and re-run scripts/install_webui.sh to lock signups.
WEBUI_ENABLE_SIGNUP=true

# --- Backups ---------------------------------------------------------------
# How many timestamped backups (backups/local-code-agent-backup-*.tar.gz) to
# keep. backup.sh prunes the oldest beyond this count so they can't slowly
# fill the disk. Set 0 to disable pruning and keep every backup.
BACKUP_KEEP=7

# When the backup timer fires (systemd OnCalendar syntax). Quote it — it has
# spaces. Examples: "daily", "weekly", "*-*-* 03:30:00", "Mon *-*-* 02:00:00".
# Applied by 'backup.sh --install-timer'; re-run that after changing it.
BACKUP_SCHEDULE="*-*-* 03:30:00"
