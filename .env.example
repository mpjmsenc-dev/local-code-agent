# local-code-agent configuration
# Copied to .env automatically on first run (never commit .env).
# Every script reads this file; change a value and re-run the matching script.

# --- Auto-tune -------------------------------------------------------------
# true  = on every boot (and during setup) scripts/tune.sh detects the VM's
#         RAM and picks the best model + context length automatically, so
#         resizing the droplet upgrades/downgrades the model by itself.
# false = you pin MODEL_NAME / OLLAMA_CONTEXT_LENGTH manually below.
AUTO_TUNE=true

# The Ollama model used by aider and Open WebUI. When AUTO_TUNE=true this is
# managed for you. See README for the RAM ladder (3b/7b/14b variants).
MODEL_NAME=qwen2.5-coder:7b

# Which model FAMILY auto-tune picks from. It chooses the largest size in this
# family that fits your RAM, so you can change the model everywhere by changing
# one line. Supported: qwen2.5-coder (default, best all-round coder),
# qwen3, deepseek-coder-v2, llama3.1, codellama.
# An unknown value falls back to the default rather than failing a pull.
MODEL_FAMILY=qwen2.5-coder

# --- Ollama server ---------------------------------------------------------
# Listen address for the Ollama API. Keep it on loopback: phone access goes
# through Open WebUI over Tailscale, so Ollama never needs to be exposed.
OLLAMA_HOST=127.0.0.1:11434

# Context window (tokens). Managed by auto-tune; lower it if you hit OOM.
OLLAMA_CONTEXT_LENGTH=8192

# How long a model stays loaded in RAM after the last request.
OLLAMA_KEEP_ALIVE=30m

# --- Aider (terminal coding agent) -----------------------------------------
# Pin a specific aider-chat version (e.g. 0.86.1). Empty = latest.
AIDER_VERSION=

# Python interpreter used to create the virtualenv.
PYTHON_BIN=python3

# Virtualenv directory name (created inside this repository).
VENV_NAME=.venv

# true = load config/CONVENTIONS.md read-only every aider session so the local
# model makes smaller, in-style edits. Costs a little context; set false on the
# smallest (4096-token) windows if you need every token for the task.
AIDER_CONVENTIONS=true

# NOTE the LCA_ prefix: .env is sourced with 'set -a', so every key here is
# EXPORTED. 'AIDER_EDIT_FORMAT' is aider's own env var, and setting it to our
# sentinel "auto" (not a valid aider format) breaks every direct 'aider' call —
# including 'aider --version'. Keep our own knobs out of the AIDER_ namespace.
# How aider asks the model to express edits. "auto" (recommended) picks per
# model: small models (<=4B) get "whole" (rewrite the file — far more reliable
# than diffs for them), bigger ones get "diff" (much cheaper on context).
# Force one with: whole | diff | udiff | diff-fenced
LCA_EDIT_FORMAT=auto

# Max tokens 'lca ask' will generate for one answer. On CPU (a few tokens per
# second) an uncapped reply can run for minutes; raise it for longer answers.
LCA_ASK_TOKENS=512

# --- Docker / Open WebUI (the phone chat app) ------------------------------
# true = skip Docker entirely (also disables Open WebUI).
SKIP_DOCKER=false

# false = don't install/run Open WebUI (aider still works in the terminal).
ENABLE_WEBUI=true

# Port Open WebUI listens on (reached from your phone via Tailscale).
WEBUI_PORT=3000

# Name of the Open WebUI docker container.
WEBUI_CONTAINER=open-webui

# Title shown in the chat app on your phone (branding only).
WEBUI_NAME=local-code-agent

# true only until you created YOUR account (the first account is the admin).
# Then set false and re-run scripts/install_webui.sh to lock signups.
WEBUI_ENABLE_SIGNUP=true

# --- Backups ---------------------------------------------------------------
# How many timestamped backups (backups/local-code-agent-backup-*.tar.gz) to
# keep. backup.sh prunes the oldest beyond this count so they can't slowly
# fill the disk. Set 0 to disable pruning and keep every backup.
BACKUP_KEEP=7

# When the backup timer fires (systemd OnCalendar syntax). Quote it — it has
# spaces. Examples: "daily", "weekly", "*-*-* 03:30:00", "Mon *-*-* 02:00:00".
# Applied by 'backup.sh --install-timer'; re-run that after changing it.
BACKUP_SCHEDULE="*-*-* 03:30:00"
