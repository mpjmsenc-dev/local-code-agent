#!/usr/bin/env bash
# bin/lca — one short command for everyday use, installed on PATH as 'lca'.
#
# Typing /opt/local-code-agent/run-agent.sh every time is the kind of friction
# that stops people using their own tools. Every subcommand just forwards to the
# script that already does the work, with all arguments passed through.
#
# IMPORTANT: this never cd's. 'lca' with no arguments starts the coding agent in
# YOUR current directory, which is the whole point — aider must see your project.
set -euo pipefail

# Resolve through the /usr/local/bin/lca symlink to the real checkout, so the
# install location is wherever the user actually put it.
SELF="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then
  SELF="$(readlink -f "${SELF}" 2>/dev/null || printf '%s' "${SELF}")"
fi
REPO="$(cd "$(dirname "${SELF}")/.." && pwd)"

usage() {
  cat <<EOF
local-code-agent — private AI stack

Usage: lca [command] [args...]

  lca                     start the coding agent here (aider, in \$PWD)
  lca ask "question"      one-shot answer, no session, no browser
  lca ask -f FILE "q"     ask about a file (pipe also works: cmd | lca ask "q")
  lca ask -c "follow up"  continue from your last question
  lca ask -m MODEL "q"    answer with another model just this once
  lca chat                phone setup: chat URL + SSH address, both as QR codes
  lca apply               make the running system match your .env edits
  lca check [--quick]     full health check (--quick skips the slow model probe)
  lca logs [-f] [source]  recent logs (ollama | webui | setup | all)
  lca speed               measure tokens/second and explain what limits it
  lca test                live end-to-end self-test (proves it really works)
  lca update [--check]    back up, update, re-run setup, verify
  lca backup              take a backup now
  lca restore [file]      restore from a backup
  lca model <name>        switch the model ('--list' installed, '--list-recommended' fits your RAM)
  lca tune                re-pick the model for this machine's RAM (auto-tune)
  lca offline|online      internet kill switch  (needs sudo)
  lca status              kill-switch + guard status (needs sudo)
  lca harden              re-close ports 3000/11434 now and on every boot (sudo)
  lca webui <cmd>         start|stop|restart|status|url|logs
  lca help                this text

Every command explains itself, and only explains itself:
  lca <command> --help

Anything after the command is passed straight through, e.g.
  lca --no-auto-commits          (arguments for aider)
  lca model qwen2.5-coder:14b --remove-old
EOF
}

cmd="${1:-}"
# Drop the subcommand so "$@" is exactly the arguments to forward. Guarded with
# if/fi rather than 'A && B || C', which is not if-then-else: with no arguments
# the shift would fail and the || branch would mask it.
if (( $# > 0 )); then
  shift
fi

case "${cmd}" in
  ""|agent|code)   exec "${REPO}/run-agent.sh" "$@" ;;
  ask)             exec "${REPO}/scripts/ask.sh" "$@" ;;
  # "$@" forwarded like every other branch, even though 'url' takes no
  # arguments: dropping it swallowed 'lca chat --help', which then printed the
  # address instead of explaining the command — one line after 'lca help'
  # promises that every command explains itself. webui.sh rejects the extra
  # argument itself; that is its job, not this dispatcher's.
  chat)            exec "${REPO}/webui.sh" url "$@" ;;
  apply)           exec "${REPO}/scripts/apply.sh" "$@" ;;
  check)           exec "${REPO}/check-system.sh" "$@" ;;
  speed)           exec "${REPO}/scripts/speed.sh" "$@" ;;
  logs)            exec "${REPO}/scripts/logs.sh" "$@" ;;
  test|selftest)   exec "${REPO}/scripts/selftest.sh" "$@" ;;
  update)          exec "${REPO}/update.sh" "$@" ;;
  backup)          exec "${REPO}/backup.sh" "$@" ;;
  restore)         exec "${REPO}/restore.sh" "$@" ;;
  model)           exec "${REPO}/update-model.sh" "$@" ;;
  offline|online|status|harden)
                   exec "${REPO}/netmode.sh" "${cmd}" "$@" ;;
  webui)           exec "${REPO}/webui.sh" "$@" ;;
  tune)            exec "${REPO}/scripts/tune.sh" "$@" ;;
  help|-h|--help)  usage ;;
  # 'lca help' has advertised "lca --no-auto-commits (arguments for aider)"
  # since the help text was written, and it did not work: a leading dash
  # matched no branch and fell through to "Unknown command". Bare 'lca' starts
  # aider, so passing aider's own flags straight after it is the obvious
  # reading, and it is what the example promises.
  #
  # "${cmd}" is re-prepended because the shift above already consumed it.
  # Placed after the help branch so -h and --help keep their meaning.
  -*)              exec "${REPO}/run-agent.sh" "${cmd}" "$@" ;;
  *)
    usage
    printf '\nUnknown command: %s\n' "${cmd}" >&2
    exit 1
    ;;
esac
