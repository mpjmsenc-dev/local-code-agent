#!/usr/bin/env bash
# pre-push hook — run the CI gates that CAN run here, before anything reaches
# GitHub.
#
# Installed by `make hooks` (sets git's core.hooksPath to .githooks/). This is
# the safety rail for the AI-assisted loop: an agent edits code, this runs
# ShellCheck, bash -n and both unit suites, and a push that fails them never
# leaves the machine.
#
# This used to claim it ran everything CI does, and that a push through it
# could not open a failing PR. Both halves were untrue, and both were measured
# on this project. (Paraphrased rather than quoted: a gate in the test suite
# refuses those sentences, and it greps this file.)
#
# CI has 6 jobs and this runs two of them. The other four need a fresh machine
# and cannot exist here: the system-artifact job (nft ruleset and systemd
# units), the minimal-base install, the real Ollama install and generation, and
# the Open WebUI container with its backup/restore round trip.
#
# And the two it DOES run can answer differently there. CI's runner is a
# non-root passwordless sudoer with a real Docker daemon behind it; a developer
# box is usually root, where nothing escalates. Two pushes on this project went
# green here and red there for exactly that reason — a PATH stub sudo walked
# past, and a DOCKER_HOST sudo stripped.
#
# So a green hook is a strong signal, not a guarantee. Watch the run.
#
# Bypass a single push with:  git push --no-verify
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "${repo_root}"

echo "pre-push: running 'make gates' (shellcheck + bash -n + unit tests)..."
if make gates; then
  echo "pre-push: gates passed — pushing."
else
  echo "pre-push: gates FAILED — push aborted." >&2
  echo "          Fix the findings above (shellcheck: apt-get install -y shellcheck)," >&2
  echo "          or bypass this one push with: git push --no-verify" >&2
  exit 1
fi
