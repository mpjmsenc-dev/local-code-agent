# Local configuration (contains machine-specific values; never commit)
.env
# restore.sh writes these beside it: the .env it replaced, and one it refused
# to install. Both are somebody's real configuration, so they are no more
# committable than .env itself — and '.env' alone does not match them.
.env.pre-restore
.env.rejected

# Python virtualenv
.venv/

# Aider state (history, cache, per-repo settings)
.aider*

# Logs
*.log
# ...and the lock start_ollama_bg holds beside the log. '*.log' does not
# match '.ollama-serve.log.lock', so 'git add -A' committed the running
# lock file once — a runtime artefact shipped to every checkout.
*.log.lock

# Python bytecode
__pycache__/

# Local backups created by backup.sh
backups/
