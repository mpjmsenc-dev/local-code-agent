# Extra environment for the Ollama systemd service.
# Each KEY=VALUE line here becomes an Environment= line in the systemd
# drop-in rendered by scripts/install_ollama.sh and scripts/tune.sh.
# (Comments and blank lines are ignored.)

# Only one model in RAM at a time — essential on 8 GB droplets.
OLLAMA_MAX_LOADED_MODELS=1

# Ollama ships with its cloud features ON: remote inference and web search,
# which contact ollama.com. This project's headline claim is "no cloud AI APIs,
# no API keys, no telemetry", so leaving them enabled contradicted the first
# line of the README. Nothing here uses them — the model runs locally.
OLLAMA_NO_CLOUD=1

# Ollama gives a model load 5 minutes by default, which is a GPU's budget, not
# a cold CPU box's. Measured here on qwen2.5-coder:7b with nothing in the page
# cache: the load ran past 5 minutes, Ollama gave up, and 'lca ask' reported
#
#   timed out waiting for llama-server to start -
#
# with nothing resident afterwards. The same command straight after answered in
# 32s, because the abandoned attempt had left the 4.7 GB of weights in the page
# cache. Nothing was wrong with the machine; the deadline was just short enough
# to fail the one load that always costs the most — the first one.
#
# 15m is chosen against that measurement, not a round number: it clears the
# worst first load seen here several times over, on a box whose whole design
# point is that inference is slow but works. The cost is that a load which is
# genuinely wedged is reported in 15 minutes rather than 5, and a wedged load
# is the rarer of the two by far.
OLLAMA_LOAD_TIMEOUT=15m
